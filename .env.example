# WohnOra-Germany Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Supabase (if using Supabase for auth/database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (for payments)
VITE_STRIPE_PUBLIC_KEY=pk_test_your-key-here

# Google Maps API Key (for Map component)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# App Configuration
VITE_APP_NAME=WohnOra
VITE_APP_URL=http://localhost:5173